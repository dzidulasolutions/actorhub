APIFY_API_TOKEN
# Budget maximum par run, en dollars (défaut : 1)
APIFY_MAX_CHARGE_USD=1

# Code que tu tapes pour entrer dans l'app (12 caractères ou plus, unique, pas réutilisé ailleurs)
ACCESS_CODE=

# Sert à signer la session (colle ici le résultat de la commande ci-dessus)
SESSION_SECRET=

# Envoi d'emails depuis ton propre Gmail (usage local)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nom affiché comme expéditeur (facultatif)
MAIL_FROM_NAME=
# Plafond d'envois par jour (défaut 30). Gmail en autorise environ 500 pour un compte gratuit,
# mais envoyer vite et beaucoup abîme la réputation de ton adresse.
MAIL_DAILY_LIMIT=30